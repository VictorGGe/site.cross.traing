# Port HTTP
PORT=3000
# URL publique du site (utilisée dans les e-mails et les retours de paiement)
BASE_URL=http://localhost:3000

# Mot de passe de l'espace admin (/admin) — OBLIGATOIRE en production
ADMIN_PASSWORD=change-moi
# Clé secrète pour signer les cookies (une longue chaîne aléatoire)
SESSION_SECRET=remplace-par-une-chaine-aleatoire-longue

# Paiement par carte (Stripe Checkout) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Optionnel : secret du webhook Stripe (endpoint : /webhook/stripe)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# E-mails (optionnel — sans SMTP, les e-mails sont affichés dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VG Cross Training <contact@exemple.fr>"

# Emplacement de la base de données SQLite
DATABASE_PATH=./data/cross-training.db
